# Frontend for the RoxChain dev network.

# --- where the app and API live (through the local nginx proxy on :8088) ---
NEXT_PUBLIC_APP_HOST=localhost
NEXT_PUBLIC_APP_PROTOCOL=http
NEXT_PUBLIC_APP_PORT=8088
NEXT_PUBLIC_API_HOST=localhost
NEXT_PUBLIC_API_PROTOCOL=http
NEXT_PUBLIC_API_PORT=8088
NEXT_PUBLIC_API_BASE_PATH=/
NEXT_PUBLIC_API_WEBSOCKET_PROTOCOL=ws

# --- network ---
NEXT_PUBLIC_NETWORK_NAME=RoxChain Devnet
NEXT_PUBLIC_NETWORK_SHORT_NAME=RoxChain
NEXT_PUBLIC_NETWORK_ID=20260
# through the local proxy (forwards to https://ro-dev.roxchain.io); the RPC node rejects direct browser calls (CORS)
NEXT_PUBLIC_NETWORK_RPC_URL=http://localhost:8088/rpc
NEXT_PUBLIC_NETWORK_CURRENCY_NAME=Rox
NEXT_PUBLIC_NETWORK_CURRENCY_SYMBOL=ROX
NEXT_PUBLIC_NETWORK_CURRENCY_DECIMALS=18
# unit names instead of wei / Gwei: 1 ROX = 10^18 bitrox, 1 Gbitrox = 10^9 bitrox
NEXT_PUBLIC_NETWORK_CURRENCY_WEI_NAME=bitrox
NEXT_PUBLIC_NETWORK_CURRENCY_GWEI_NAME=Gbitrox
NEXT_PUBLIC_IS_TESTNET=true
# home page banner heading (mainnet: RoxChain Explorer)
NEXT_PUBLIC_HOMEPAGE_HERO_TITLE=RoxChain Devnet Explorer
# label on the top-bar badge and warnings: Devnet now (internal, may be reset), Testnet later (partners)
NEXT_PUBLIC_NETWORK_TESTNET_LABEL=Devnet
# QBFT block periods (genesis blockperiodseconds / emptyblockperiodseconds), shown on the home page
NEXT_PUBLIC_NETWORK_BLOCK_PERIOD_SECONDS=1
NEXT_PUBLIC_NETWORK_EMPTY_BLOCK_PERIOD_SECONDS=60

# --- free gas, no price feed ---
NEXT_PUBLIC_GAS_TRACKER_ENABLED=false
NEXT_PUBLIC_HIDE_NATIVE_COIN_PRICE=true
NEXT_PUBLIC_HOMEPAGE_CHARTS=[]

# --- RoxChain branding (files in local/branding, served by the proxy at /branding) ---
NEXT_PUBLIC_NETWORK_LOGO=http://localhost:8088/branding/roxchain-logo.svg
NEXT_PUBLIC_NETWORK_LOGO_DARK=http://localhost:8088/branding/roxchain-logo-dark.svg
NEXT_PUBLIC_NETWORK_ICON=http://localhost:8088/branding/roxchain-icon.svg
NEXT_PUBLIC_NETWORK_ICON_DARK=http://localhost:8088/branding/roxchain-icon-dark.svg
FAVICON_MASTER_URL=http://localhost:8088/branding/roxchain-icon-512.png
NEXT_PUBLIC_OG_IMAGE_URL=http://localhost:8088/branding/roxchain-og.png
NEXT_PUBLIC_OG_DESCRIPTION=RoxChain Explorer. Search transactions, blocks, tokens, NFTs and addresses on the RoxChain network.
NEXT_PUBLIC_PROMOTE_BLOCKSCOUT_IN_TITLE=false

# hero: subtle navy gradient (light / dark mode); accent blue for links and buttons
# note: values containing # must be in single quotes, otherwise dotenv cuts them at the # (comment)
NEXT_PUBLIC_HOMEPAGE_HERO_BANNER_CONFIG='{"background":["linear-gradient(90deg, #01155C 0%, #102C86 100%)","linear-gradient(90deg, #0B1A55 0%, #152D78 100%)"],"text_color":["#FFFFFF","#FFFFFF"]}'
NEXT_PUBLIC_COLOR_THEME_OVERRIDES='{"button":{"primary":{"_light":{"value":"#01155C"},"_dark":{"value":"#2B4FD8"}}},"link":{"primary":{"_light":{"value":"#1A3FBF"},"_dark":{"value":"#8EA8FF"}}},"hover":{"_light":{"value":"#2B4FD8"},"_dark":{"value":"#B3C4FF"}},"selected":{"option":{"bg":{"_light":{"value":"#01155C"},"_dark":{"value":"#2B4FD8"}}}},"navigation":{"text":{"selected":{"_light":{"value":"#01155C"},"_dark":{"value":"#FFFFFF"}}},"bg":{"selected":{"_light":{"value":"#E8EDFF"},"_dark":{"value":"#0B1A55"}}}}}'

# footer links: add RoxChain link groups here, e.g.
# NEXT_PUBLIC_FOOTER_LINKS=[{"title":"RoxChain","links":[{"text":"Website","url":"https://..."}]}]
