# RoxChain Explorer - frontend (UI), devnet deployment
# Image: built from frontend/Dockerfile (see README.md). All values are read when the container starts.
# Domain: devnet.explorer.roxchain.io (mainnet later: explorer.roxchain.io).
#
# IMPORTANT: the two JSON values near the end contain "#" and are wrapped in single quotes.
#   - Docker Compose (v2) env_file: works as is (quotes are removed).
#   - `docker run --env-file`, Kubernetes ConfigMaps, most CI secret stores: remove the outer
#     single quotes, because these keep them literally and the JSON then fails to parse
#     (the page silently falls back to default colours).

# --- where the app and API live (same domain; nginx routes /api and /socket to the backend) ---
NEXT_PUBLIC_APP_HOST=devnet.explorer.roxchain.io
NEXT_PUBLIC_APP_PROTOCOL=https
NEXT_PUBLIC_API_HOST=devnet.explorer.roxchain.io
NEXT_PUBLIC_API_PROTOCOL=https
NEXT_PUBLIC_API_BASE_PATH=/
NEXT_PUBLIC_API_WEBSOCKET_PROTOCOL=wss

# --- network ---
NEXT_PUBLIC_NETWORK_NAME=RoxChain Devnet
NEXT_PUBLIC_NETWORK_SHORT_NAME=RoxChain
NEXT_PUBLIC_NETWORK_ID=20260
# the browser calls the RPC through nginx (/rpc), because the RPC node rejects browser calls from other origins (CORS)
NEXT_PUBLIC_NETWORK_RPC_URL=https://devnet.explorer.roxchain.io/rpc
NEXT_PUBLIC_NETWORK_CURRENCY_NAME=Rox
NEXT_PUBLIC_NETWORK_CURRENCY_SYMBOL=ROX
NEXT_PUBLIC_NETWORK_CURRENCY_DECIMALS=18
# unit names instead of wei / Gwei: 1 ROX = 10^18 bitrox, 1 Gbitrox = 10^9 bitrox
NEXT_PUBLIC_NETWORK_CURRENCY_WEI_NAME=bitrox
NEXT_PUBLIC_NETWORK_CURRENCY_GWEI_NAME=Gbitrox
NEXT_PUBLIC_IS_TESTNET=true
# home page banner heading (mainnet: RoxChain Explorer)
NEXT_PUBLIC_HOMEPAGE_HERO_TITLE=RoxChain Devnet Explorer
# label on the top-bar badge and warnings (mainnet: leave NEXT_PUBLIC_IS_TESTNET unset)
NEXT_PUBLIC_NETWORK_TESTNET_LABEL=Devnet
# QBFT block period (genesis blockperiodseconds), shown on the home page
NEXT_PUBLIC_NETWORK_BLOCK_PERIOD_SECONDS=1

# --- free gas, no price feed ---
NEXT_PUBLIC_GAS_TRACKER_ENABLED=false
NEXT_PUBLIC_HIDE_NATIVE_COIN_PRICE=true
NEXT_PUBLIC_HOMEPAGE_CHARTS=[]

# --- branding: files from the repo's local/branding/ folder, served by nginx at /branding/ ---
# the container downloads these at startup, so the URLs must be reachable from the container
NEXT_PUBLIC_NETWORK_LOGO=https://devnet.explorer.roxchain.io/branding/roxchain-logo.svg
NEXT_PUBLIC_NETWORK_LOGO_DARK=https://devnet.explorer.roxchain.io/branding/roxchain-logo-dark.svg
NEXT_PUBLIC_NETWORK_ICON=https://devnet.explorer.roxchain.io/branding/roxchain-icon.svg
NEXT_PUBLIC_NETWORK_ICON_DARK=https://devnet.explorer.roxchain.io/branding/roxchain-icon-dark.svg
FAVICON_MASTER_URL=https://devnet.explorer.roxchain.io/branding/roxchain-icon-512.png
NEXT_PUBLIC_OG_IMAGE_URL=https://devnet.explorer.roxchain.io/branding/roxchain-og.png
NEXT_PUBLIC_OG_DESCRIPTION=RoxChain Explorer. Search transactions, blocks, tokens, NFTs and addresses on the RoxChain network.
NEXT_PUBLIC_PROMOTE_BLOCKSCOUT_IN_TITLE=false

# --- colours (single-quoted: see the note at the top) ---
NEXT_PUBLIC_HOMEPAGE_HERO_BANNER_CONFIG='{"background":["linear-gradient(90deg, #01155C 0%, #102C86 100%)","linear-gradient(90deg, #0B1A55 0%, #152D78 100%)"],"text_color":["#FFFFFF","#FFFFFF"]}'
NEXT_PUBLIC_COLOR_THEME_OVERRIDES='{"button":{"primary":{"_light":{"value":"#01155C"},"_dark":{"value":"#2B4FD8"}}},"link":{"primary":{"_light":{"value":"#1A3FBF"},"_dark":{"value":"#8EA8FF"}}},"hover":{"_light":{"value":"#2B4FD8"},"_dark":{"value":"#B3C4FF"}},"selected":{"option":{"bg":{"_light":{"value":"#01155C"},"_dark":{"value":"#2B4FD8"}}}},"navigation":{"text":{"selected":{"_light":{"value":"#01155C"},"_dark":{"value":"#FFFFFF"}}},"bg":{"selected":{"_light":{"value":"#E8EDFF"},"_dark":{"value":"#0B1A55"}}}}}'
SKIP_ENVS_VALIDATION=true
