# Backend (indexer + API) for the RoxChain dev network.
# The dev RPC only enables the ETH API (no trace/debug/txpool, no websocket), so the features
# that need those are switched off below.

# --- chain ---
ETHEREUM_JSONRPC_VARIANT=besu
ETHEREUM_JSONRPC_HTTP_URL=https://ro-dev.roxchain.io
ETHEREUM_JSONRPC_TRACE_URL=https://ro-dev.roxchain.io
ETHEREUM_JSONRPC_TRANSPORT=http
CHAIN_ID=20260
COIN=ROX
COIN_NAME=Rox
NETWORK=RoxChain
SUBNETWORK=Dev

# --- database ---
# DATABASE_URL and SECRET_KEY_BASE are set in docker-compose.yml from local/.env (not committed)
ECTO_USE_SSL=false
POOL_SIZE=40
POOL_SIZE_API=10

# --- server ---
PORT=4000
BLOCKSCOUT_PROTOCOL=http
BLOCKSCOUT_HOST=localhost
DISABLE_FILE_LOGGING=true

# --- features the dev RPC can't serve (need trace/debug/txpool or archive state) ---
INDEXER_DISABLE_INTERNAL_TRANSACTIONS_FETCHER=true
INDEXER_DISABLE_PENDING_TRANSACTIONS_FETCHER=true
INDEXER_DISABLE_BLOCK_REWARD_FETCHER=true
ETHEREUM_JSONRPC_DISABLE_ARCHIVE_BALANCES=true

# --- not used on RoxChain (free gas, no market price, no Blockscout microservices) ---
DISABLE_MARKET=true
DISABLE_EXCHANGE_RATES=true
INDEXER_DISABLE_WITHDRAWALS_FETCHER=true
ACCOUNT_ENABLED=false
MICROSERVICE_SC_VERIFIER_ENABLED=false
MICROSERVICE_SIG_PROVIDER_ENABLED=false
MICROSERVICE_BENS_ENABLED=false
MICROSERVICE_METADATA_ENABLED=false
MICROSERVICE_ACCOUNT_ABSTRACTION_ENABLED=false
MICROSERVICE_TRANSACTION_INTERPRETATION_ENABLED=false
NFT_MEDIA_HANDLER_ENABLED=false
RE_CAPTCHA_DISABLED=true
